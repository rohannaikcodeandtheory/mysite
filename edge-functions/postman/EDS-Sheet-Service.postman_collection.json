{
  "info": {
    "name": "EDS Sheet Service - AEM Edge Functions",
    "description": "Requires stage domain and Cloud Manager secret; do not commit real tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://stage.example.com"
    },
    {
      "key": "apiKey",
      "value": "REPLACE_USING_POSTMAN_SECRET_VARIABLE",
      "type": "secret"
    }
  ],
  "item": [
    {
      "name": "01 - Dry Run Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operation\": \"createSheet\",\n  \"path\": \"data/testing/edge-test.json\",\n  \"dryRun\": true,\n  \"sheetData\": [\n    {\n      \"assetID\": \"I-NA-BCKM-410904\",\n      \"action\": \"created\",\n      \"netChange\": false,\n      \"partNumbers\": [\n        {\n          \"operation\": \"A\",\n          \"partNumber\": \"410899\"\n        }\n      ],\n      \"metadata\": {\n        \"resourceRegion\": \"NA\"\n      }\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/eds-sheets"
      }
    },
    {
      "name": "02 - Create Folder",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operation\": \"createFolder\",\n  \"path\": \"data/testing\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/eds-sheets"
      }
    },
    {
      "name": "03 - Create Sheet",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operation\": \"createSheet\",\n  \"path\": \"data/testing/edge-test.json\",\n  \"sheetData\": [\n    {\n      \"assetID\": \"I-NA-BCKM-410904\",\n      \"action\": \"created\",\n      \"netChange\": false,\n      \"partNumbers\": [\n        {\n          \"operation\": \"A\",\n          \"partNumber\": \"410899\"\n        }\n      ],\n      \"metadata\": {\n        \"resourceRegion\": \"NA\"\n      }\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/eds-sheets"
      }
    },
    {
      "name": "04 - Get Sheet",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operation\": \"getSheet\",\n  \"path\": \"data/testing/edge-test.json\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/eds-sheets"
      }
    },
    {
      "name": "05 - Update Sheet (replace)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operation\": \"updateSheet\",\n  \"path\": \"data/testing/edge-test.json\",\n  \"sheetData\": [\n    {\n      \"assetID\": \"I-NA-BCKM-410904\",\n      \"netChange\": true\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/eds-sheets"
      }
    },
    {
      "name": "06 - Move Sheet",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operation\": \"moveSheet\",\n  \"path\": \"data/testing/edge-test.json\",\n  \"destinationPath\": \"data/testing/edge-archive.json\",\n  \"confirm\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/eds-sheets"
      }
    },
    {
      "name": "07 - Delete Sheet",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operation\": \"deleteSheet\",\n  \"path\": \"data/testing/edge-archive.json\",\n  \"confirm\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/eds-sheets"
      }
    }
  ]
}
